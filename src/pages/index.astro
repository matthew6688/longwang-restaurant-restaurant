---
import Layout from '../layouts/Layout.astro';
import { restaurantData } from '../data/restaurant';
const d = restaurantData;
const tel = d.phone ? 'tel:' + d.phone.replace(/[^+0-9]/g, '') : undefined;
const mail = d.email ? 'mailto:' + d.email : undefined;
const featured = d.sections.flatMap(s => s.items.slice(0, 2)).slice(0, 6);
---
<Layout title={d.name + ' | Real Menu & Booking'} description={d.cuisine}>
  <div style={'--bg:'+d.brand.bg+';--paper:'+d.brand.paper+';--ink:'+d.brand.ink+';--muted:'+d.brand.muted+';--accent:'+d.brand.accent+';--accent2:'+d.brand.accent2} class="-mx-6 -mt-12 bg-[var(--paper)] text-[var(--ink)] md:rounded-b-[2rem]">
    <section class="grid min-h-[82vh] gap-8 p-5 md:p-10 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div class="order-2 lg:order-1">
        <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-black/10 bg-white/50 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-[var(--accent)]">Google Places + official menu</div>
        <img src={d.logoImage} alt={d.name + ' logo'} class:list={["mb-7 max-h-24 max-w-[260px] object-contain", d.brand.logoInvert && "rounded-xl bg-[var(--bg)] p-4"]} />
        <h1 class="max-w-3xl text-5xl font-black leading-[0.9] tracking-tight md:text-7xl">{d.name}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)] md:text-xl">{d.cuisine}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/menu" class="rounded-full bg-[var(--bg)] px-6 py-3 text-sm font-black text-white">View menu</a>
          <a href={d.bookingUrl} target="_blank" class="rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-black text-white">Reserve</a>
          {tel && <a href={tel} class="rounded-full border border-black/15 px-6 py-3 text-sm font-black">Call</a>}
          <a href={d.googleMapsUrl} target="_blank" class="rounded-full border border-black/15 px-6 py-3 text-sm font-black">Navigate</a>
        </div>
      </div>
      <div class="order-1 grid h-[520px] grid-cols-5 grid-rows-5 gap-3 lg:order-2">
        <img src={d.heroImage} alt={d.name + ' dining room'} class="col-span-5 row-span-3 h-full w-full rounded-[2rem] object-cover shadow-2xl" />
        {d.galleryImages.slice(0,3).map((img,i)=><img src={img} alt={d.name + ' photo'} class:list={["h-full w-full rounded-2xl object-cover shadow-lg", i===0 ? "col-span-2 row-span-2" : "col-span-?", "col-span-?"].filter(Boolean)} />)}
      </div>
    </section>
    <section class="grid gap-4 px-5 pb-10 md:grid-cols-4 md:px-10">
      <a href={d.googleMapsUrl} target="_blank" class="rounded-2xl bg-white/65 p-5 shadow-sm"><span class="block text-xs font-black uppercase tracking-widest text-[var(--accent)]">Address</span><strong class="mt-2 block">{d.address}</strong></a>
      <a href={tel} class="rounded-2xl bg-white/65 p-5 shadow-sm"><span class="block text-xs font-black uppercase tracking-widest text-[var(--accent)]">Phone</span><strong class="mt-2 block">{d.phone}</strong></a>
      {mail ? <a href={mail} class="rounded-2xl bg-white/65 p-5 shadow-sm"><span class="block text-xs font-black uppercase tracking-widest text-[var(--accent)]">Email</span><strong class="mt-2 block break-all">{d.email}</strong></a> : <a href={d.website} target="_blank" class="rounded-2xl bg-white/65 p-5 shadow-sm"><span class="block text-xs font-black uppercase tracking-widest text-[var(--accent)]">Website</span><strong class="mt-2 block">Official site</strong></a>}
      <div class="rounded-2xl bg-white/65 p-5 shadow-sm"><span class="block text-xs font-black uppercase tracking-widest text-[var(--accent)]">Rating</span><strong class="mt-2 block">{d.rating}/5 · {d.reviewCount} reviews</strong></div>
    </section>
  </div>
  <section class="py-14"><div class="mb-8 flex items-end justify-between"><div><p class="text-sm font-black uppercase tracking-[0.2em] text-orange-700">Signature picks</p><h2 class="text-4xl font-black">Real menu highlights</h2></div><a href="/menu" class="font-bold underline">Full menu</a></div><div class="grid gap-4 md:grid-cols-3">{featured.map(item=><article class="rounded-2xl border border-stone-200 p-5"><div class="flex justify-between gap-4"><h3 class="text-lg font-black">{item.name}</h3><span class="font-black text-orange-700">{item.price}</span></div><p class="mt-3 text-stone-600">{item.description}</p></article>)}</div></section>
</Layout>